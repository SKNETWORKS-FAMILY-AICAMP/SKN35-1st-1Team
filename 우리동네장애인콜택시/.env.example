# DB_DRIVER=mysql (기본, 운영용) 또는 sqlite (MySQL 없이 로컬 데모용, DEMO_SQLITE_PATH 파일 사용)
DB_DRIVER=mysql
DEMO_SQLITE_PATH=data/demo.db

# MySQL 접속 정보
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# 네이버 뉴스 검색 API (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# FAQ 원본 출처
FAQ_SOURCE_URL=
FAQ_SOURCE_NAME=서울시설공단 장애인콜택시

# 공식 예약/문의 채널 (README 및 예약하기 페이지에 노출)
OFFICIAL_RESERVATION_URL=
OFFICIAL_PHONE_NUMBER=
OFFICIAL_SMS_NUMBER=
